# ─── SmartSahay Frontend — Environment Variables ───────────────────────────
#
# VITE_API_URL
#   The root URL of the machine running the SmartSahay backend (Tomcat).
#   Just the host + port — no path, no trailing slash.
#
#   Examples:
#     Same machine:        http://localhost:8080
#     Another machine:     http://192.168.1.42:8080
#     Another machine:     http://YOUR_TEAMMATE_IP:8080
#
# The Vite dev server proxies every /api/* request to:
#   VITE_API_URL + /smartsahay/api/*
#
# So if the backend is on 192.168.1.42, set:
#   VITE_API_URL=http://192.168.1.42:8080
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:8080
